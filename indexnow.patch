From c84a3b9917054eb699c3a4fe7616fb35bf4ded70 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 5 Jun 2026 21:20:47 +0000
Subject: [PATCH 2/2] feat: add IndexNow auto-submission on new blog articles

---
 .github/workflows/indexnow.yml       | 47 ++++++++++++++++++++++++++++
 b550efe9b4854369af4322a0ef7538c2.txt |  1 +
 2 files changed, 48 insertions(+)
 create mode 100644 .github/workflows/indexnow.yml
 create mode 100644 b550efe9b4854369af4322a0ef7538c2.txt

diff --git a/.github/workflows/indexnow.yml b/.github/workflows/indexnow.yml
new file mode 100644
index 0000000..352de7e
--- /dev/null
+++ b/.github/workflows/indexnow.yml
@@ -0,0 +1,47 @@
+name: IndexNow — Submit New URLs
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - 'blog/**.html'
+
+jobs:
+  submit:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 2
+
+      - name: Find new blog articles
+        id: urls
+        run: |
+          # Get list of new or modified blog HTML files in this push
+          NEW_FILES=$(git diff --name-only HEAD~1 HEAD -- 'blog/*.html' | grep -v 'blog/index.html' || true)
+          if [ -z "$NEW_FILES" ]; then
+            echo "No new articles found"
+            echo "urls=" >> $GITHUB_OUTPUT
+          else
+            URLS=""
+            for f in $NEW_FILES; do
+              SLUG=$(basename "$f" .html)
+              URLS="$URLS,\"https://rightpdfkit.com/blog/$SLUG\""
+            done
+            URLS="${URLS#,}"
+            echo "urls=$URLS" >> $GITHUB_OUTPUT
+            echo "Found URLs: $URLS"
+          fi
+
+      - name: Submit to IndexNow
+        if: steps.urls.outputs.urls != ''
+        run: |
+          curl -s -X POST "https://api.indexnow.org/indexnow" \
+            -H "Content-Type: application/json; charset=utf-8" \
+            -d "{
+              \"host\": \"rightpdfkit.com\",
+              \"key\": \"b550efe9b4854369af4322a0ef7538c2\",
+              \"keyLocation\": \"https://rightpdfkit.com/b550efe9b4854369af4322a0ef7538c2.txt\",
+              \"urlList\": [${{ steps.urls.outputs.urls }}]
+            }"
+          echo "Submitted to IndexNow"
diff --git a/b550efe9b4854369af4322a0ef7538c2.txt b/b550efe9b4854369af4322a0ef7538c2.txt
new file mode 100644
index 0000000..b876944
--- /dev/null
+++ b/b550efe9b4854369af4322a0ef7538c2.txt
@@ -0,0 +1 @@
+b550efe9b4854369af4322a0ef7538c2
\ No newline at end of file
-- 
2.43.0

